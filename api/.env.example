# Servidor
PORT=3000
NODE_ENV=development

# Supabase (service role — nunca expor no client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA — Provider generico (trocar conforme necessidade)
# Providers: openai | anthropic | google | groq | openrouter | ollama
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=                          # Opcional — usa default do provider
AI_BASE_URL=                       # Opcional — usa default do provider

# Exemplos de configuracao por provider:
#
# OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o
#
# Anthropic (Claude):
#   AI_PROVIDER=anthropic
#   AI_API_KEY=sk-ant-...
#   AI_MODEL=claude-sonnet-4-20250514
#
# Google (Gemini):
#   AI_PROVIDER=google
#   AI_API_KEY=AIza...
#   AI_MODEL=gemini-2.0-flash
#
# Groq:
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (qualquer modelo):
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-...
#   AI_MODEL=anthropic/claude-sonnet-4
#
# Ollama (local, sem chave):
#   AI_PROVIDER=ollama
#   AI_API_KEY=
#   AI_MODEL=llama3.1
#   AI_BASE_URL=http://localhost:11434/v1

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:8081
