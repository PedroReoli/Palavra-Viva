# Servidor
PORT=3000
NODE_ENV=development

# Supabase (service role — nunca expor no client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA — Google Gemini (provider padrao do Palavra Viva)
AI_PROVIDER=google
AI_API_KEY=                            # Chave da Google AI Studio (AIza...)
AI_MODEL=gemini-2.0-flash             # Modelo padrao (rapido e barato)

# Para trocar de provider, altere AI_PROVIDER e AI_API_KEY.
# Consulte docs/guia-gemini.md para detalhes.
#
# Outros providers suportados:
#   AI_PROVIDER=openai      AI_API_KEY=sk-...        AI_MODEL=gpt-4o
#   AI_PROVIDER=anthropic   AI_API_KEY=sk-ant-...    AI_MODEL=claude-sonnet-4-20250514
#   AI_PROVIDER=groq        AI_API_KEY=gsk_...       AI_MODEL=llama-3.3-70b-versatile
#   AI_PROVIDER=openrouter  AI_API_KEY=sk-or-...     AI_MODEL=google/gemini-2.0-flash
#   AI_PROVIDER=ollama      AI_API_KEY=              AI_MODEL=llama3.1

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:8081
